# =================================================================
# GitInsight AI Environment Variables Configuration
# Copy this file to '.env' and fill in your actual values.
# =================================================================

# 🔑 GitHub Personal Access Token (PAT) with repo read access
GITHUB_TOKEN=your_github_personal_access_token_here

# 🗄 PostgreSQL Database Connection String (Neon PostgreSQL / Local Postgres)
NEON_DATABASE_URL=postgresql://username:password@ep-host.region.aws.neon.tech/neondb?sslmode=require
# Alternative database URL alias:
DATABASE_URL=postgresql://username:password@ep-host.region.aws.neon.tech/neondb?sslmode=require

# 🤖 OpenRouter / OpenAI API Key for AI Repository Chatbot Insights
OPENAI_API_KEY=your_openrouter_api_key_here

# 🔐 JWT Authentication Secret Key (Generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here

# 🌐 Deployment & Service URLs
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:8501
